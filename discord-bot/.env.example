# Copie vers .env : copy .env.example .env
# Token : Discord Developer Portal -> Bot -> Reset Token
# Intents a activer : MESSAGE CONTENT, SERVER MEMBERS, GUILD
DISCORD_TOKEN=
# ID du serveur Discord (clic droit serveur -> Copier l'identifiant)
GUILD_ID=
# Salon ou les joueurs collent le code /discord
LINK_CHANNEL_ID=
# Salon des resultats d'events (KOTH, Totem, Conquest...)
EVENTS_CHANNEL_ID=
# Commande slash /stats (classements events du mois) : le bot l'enregistre tout seul sur le serveur.
# API du plugin Minecraft (discord-link.api-port / api-secret dans config.yml)
PLUGIN_URL=http://127.0.0.1:8765
PLUGIN_SECRET=
